# =============================================================
# 大数据分析服务模块 环境变量示例
# 复制本文件为 .env 后按需修改（.env 不会提交到版本库）
# 环境变量名以 ANALYTICS_ 为前缀，优先级高于代码内默认值
# =============================================================

# ---- 运行环境 ----
ANALYTICS_ENV=development
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=5000

# ---- Spark / JDK 兼容配置 ----
# PySpark 3.5.1 官方兼容 Java 8/11/17，不兼容 Java 21/25
# Fedora 等系统默认 Java 可能是 25，需在此显式指定 JDK 17 路径
# ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-temurin-jdk
# PySpark worker / driver Python 版本必须一致，多版本共存时显式指定 venv python
# PYSPARK_PYTHON=/path/to/your/venv/bin/python
# PYSPARK_DRIVER_PYTHON=/path/to/your/venv/bin/python
ANALYTICS_DEBUG=false

# ---- 数据源：mysql（Docker 容器底座，推荐）/ hdfs ----
ANALYTICS_DATA_SOURCE=mysql

# ---- 结构化大数据入库（MySQL 底座由容器 medical-mysql 提供）----
ANALYTICS_DB_ENGINE=mysql
ANALYTICS_DB_HOST=127.0.0.1
ANALYTICS_DB_PORT=3306
ANALYTICS_DB_USER=root
# 需与 deploy/docker-compose.yml 的 MYSQL_ROOT_PASSWORD 默认值一致
ANALYTICS_DB_PASSWORD=Everl^sting1
ANALYTICS_DB_NAME=sparcs_discharge_2021
ANALYTICS_DB_TABLE=sparcs_discharge_2021
ANALYTICS_DB_BATCH_SIZE=10000

# ---- MySQL -> Parquet 列式快照（消除 JDBC 冷启动 ~30s 加载）----
ANALYTICS_PARQUET_SNAPSHOT_ENABLED=true
# 留空默认 data_process/processed/sparcs_snapshot.parquet；
# Windows 下若遇权限问题可改为绝对路径
# ANALYTICS_DATA_PARQUET_PATH=C:/absolute/path/to/sparcs_snapshot.parquet
# SQLite 兜底文件路径（MySQL 不可用时写入此文件）
# ANALYTICS_DB_SQLITE_PATH=./processed/sparcs.db

# ---- 数据底座 Docker 自启（run.py 启动时经 deploy/docker-compose.yml 拉起）----
# 队友只需安装 Docker Desktop，把 sparcs_discharge_2021.ibd 放项目根目录后
# 运行根目录的 deploy-infra.bat 即可完成 MySQL/HDFS/Redis 全套部署。
ANALYTICS_MYSQL_AUTOSTART=true
ANALYTICS_HDFS_AUTOSTART=true
# 后端退出时是否停止全部底座容器（默认 true：run.py 统一启停；
# false 则容器常驻，生命周期交给 Docker restart 策略）
# ANALYTICS_INFRA_STOP_ON_EXIT=true
# 等待容器端口就绪的最长秒数（首次导入 mysql-init 数据可能较久）
# ANALYTICS_INFRA_STARTUP_WAIT=180
# ANALYTICS_INFRA_COMPOSE_DIR=   # 留空用项目根 ../deploy

# ---- HDFS 数据底座（切换 ANALYTICS_DATA_SOURCE=hdfs 时启用）----
# ANALYTICS_HDFS_NAMENODE=hdfs://localhost:8020
# ANALYTICS_HDFS_PATH=/data/sparcs_snapshot.parquet

# ---- Spark ----
# 本地开发用 local[*]；生产环境可改为 spark://master:7077 或 yarn
ANALYTICS_SPARK_MASTER=local[*]
ANALYTICS_SPARK_LOG_LEVEL=WARN
# 指定 JAVA_HOME（留空则自动探测：环境变量 -> 候选路径 -> 报错提示）
# Linux 示例：ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# ---- 结果缓存（二期：in-memory / redis 可切换，Redis 不可用时自动降级）----
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_BACKEND=in-memory
ANALYTICS_CACHE_TTL_SECONDS=300
ANALYTICS_CACHE_MAX_ENTRIES=256
# Redis 后端参数（ANALYTICS_CACHE_BACKEND=redis 时生效；依赖可选安装 redis>=5）
# ANALYTICS_REDIS_HOST=127.0.0.1
# ANALYTICS_REDIS_PORT=6379
# ANALYTICS_REDIS_DB=0
# ANALYTICS_REDIS_PASSWORD=
# ANALYTICS_REDIS_CONNECT_TIMEOUT=2.0

# ---- 超时与慢查询（二期 3.3.4 API 性能优化）----
# 聚合/算法计算超时阈值（秒），<=0 表示不限制；超时返回 504
ANALYTICS_AGG_TIMEOUT_SECONDS=120
ANALYTICS_ALGO_TIMEOUT_SECONDS=300
# 超过该耗时的请求记入慢查询并告警
ANALYTICS_SLOW_QUERY_THRESHOLD_SECONDS=5

# ---- 权限与限流（二期 3.3.5 API 异常处理机制）----
ANALYTICS_API_AUTH_ENABLED=false
# 启用认证后填写逗号分隔的合法 Token（留空将拒绝所有请求）
# ANALYTICS_API_AUTH_TOKENS=
# 免认证路径前缀（逗号分隔，默认健康检查公开）
ANALYTICS_API_AUTH_PUBLIC_PATHS=/api/v1/health
ANALYTICS_RATE_LIMIT_ENABLED=false
ANALYTICS_RATE_LIMIT_REQUESTS=100
ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=60

# ---- 聚合接口限制 ----
ANALYTICS_AGG_MAX_LIMIT=1000

# ---- 机器学习 ----
ANALYTICS_ML_SAMPLE_SIZE=100000
ANALYTICS_ML_TRAIN_RATIO=0.8

# ---- AI 智能层（人员4：意图识别 / 文本生成）----
# provider 可选：auto / deepseek / openai / mock / disabled
# auto = 按 api_key 是否配置自动选（有 key 走 deepseek，无 key 走 mock）
ANALYTICS_LLM_PROVIDER=auto
# 留空时降级到 Mock 生成（不报错，便于离线开发与测试）
ANALYTICS_LLM_API_KEY=
# 留空时按 provider 自动选择：
#   provider=deepseek -> https://api.deepseek.com/v1
#   provider=openai   -> 不设置 base_url（openai SDK 走官方）
# 本地 LLM（如 vLLM / Ollama OpenAI 兼容接口）：
#   ANALYTICS_LLM_BASE_URL=http://localhost:8000/v1
ANALYTICS_LLM_BASE_URL=
# DeepSeek-V3（默认）；deepseek-reasoner=R1；gpt-4o-mini 等其他 OpenAI 兼容模型也可
ANALYTICS_LLM_MODEL=deepseek-chat
ANALYTICS_LLM_TIMEOUT=30
ANALYTICS_LLM_TEMPERATURE=0.2
ANALYTICS_LLM_MAX_TOKENS=800
ANALYTICS_INTENT_MIN_CONFIDENCE=0.45

# ---- 本地 AI 模型自启（provider=ollama 时，run.py 自动拉起/停止 Ollama）----
# 退出时只停止本进程拉起的 serve，原本已在运行的 Ollama 不受影响
# ANALYTICS_LLM_AUTOSTART=true
# ANALYTICS_OLLAMA_BIN=         # ollama 可执行文件；留空按 PATH 查找
# ANALYTICS_OLLAMA_STARTUP_WAIT=90
# ANALYTICS_OLLAMA_PULL_ON_MISSING=true   # 配置的模型缺失时自动 ollama pull

# ---- 前端自启（run.py 一键启动时自动拉起 Vue3 大屏前端）----
# 退出时自动停止本进程拉起的 npm 进程；端口被占用（已自行启动）时自动跳过
# ANALYTICS_FRONTEND_ENABLED=true
# 可选 dev（vite dev server，热更新）/ preview（先 npm run build 再预览）
# ANALYTICS_FRONTEND_MODE=dev
# 前端项目目录；留空按 run.py 自动推导 ../smart-medical-frontend
# ANALYTICS_FRONTEND_DIR=
# ANALYTICS_FRONTEND_HOST=127.0.0.1
# ANALYTICS_FRONTEND_PORT=5173
# ANALYTICS_FRONTEND_AUTO_INSTALL=true   # 依赖缺失时自动 npm install

# ---- 运行模式（方案A容器化）----
# host：宿主机直接运行 Flask（需本机 JDK + Spark 环境，默认，向后兼容）
# container：run.py 编排 docker compose 拉起应用容器，宿主机零依赖
#   （JDK / Hadoop / winutils 全部打包进镜像；容器内网直连 mysql/hdfs/redis）
# 无论哪种模式，前端与 Ollama 自启逻辑不变
ANALYTICS_RUN_MODE=host
# 容器化模式下等待应用容器健康的最长秒数（首次构建约 5~10 分钟）
# ANALYTICS_APP_STARTUP_WAIT=600

