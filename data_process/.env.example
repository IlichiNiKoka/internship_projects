# =============================================================
# 大数据分析服务模块 环境变量示例
# 复制本文件为 .env 后按需修改（.env 不会提交到版本库）
# 环境变量名以 ANALYTICS_ 为前缀，优先级高于代码内默认值
# =============================================================

# ---- 运行环境 ----
ANALYTICS_ENV=development
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=5000

# ---- Spark / JDK 兼容配置 ----
# PySpark 3.5.1 官方兼容 Java 8/11/17，不兼容 Java 21/25
# Fedora 等系统默认 Java 可能是 25，需在此显式指定 JDK 17 路径
# ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-temurin-jdk
# PySpark worker / driver Python 版本必须一致，多版本共存时显式指定 venv python
# PYSPARK_PYTHON=/path/to/your/venv/bin/python
# PYSPARK_DRIVER_PYTHON=/path/to/your/venv/bin/python
ANALYTICS_DEBUG=false

# ---- 数据源（清洗后 CSV 路径，默认自动推导到 ./processed/）----
# ANALYTICS_DATA_CSV_PATH=/data/clean.csv

# ---- Spark ----
# 本地开发用 local[*]；生产环境可改为 spark://master:7077 或 yarn
ANALYTICS_SPARK_MASTER=local[*]
ANALYTICS_SPARK_LOG_LEVEL=WARN
# 指定 JAVA_HOME（留空则自动探测：环境变量 -> 候选路径 -> 报错提示）
# Linux 示例：ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# ---- 结果缓存（一期为进程内 TTL 缓存，二期切换 Redis）----
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL_SECONDS=300
ANALYTICS_CACHE_MAX_ENTRIES=256

# ---- 聚合接口限制 ----
ANALYTICS_AGG_MAX_LIMIT=1000

# ---- 机器学习 ----
ANALYTICS_ML_SAMPLE_SIZE=100000
ANALYTICS_ML_TRAIN_RATIO=0.8

# ---- AI 智能层（人员4：意图识别 / 文本生成）----
# provider 可选：auto / deepseek / openai / mock / disabled
# auto = 按 api_key 是否配置自动选（有 key 走 deepseek，无 key 走 mock）
ANALYTICS_LLM_PROVIDER=auto
# 留空时降级到 Mock 生成（不报错，便于离线开发与测试）
ANALYTICS_LLM_API_KEY=
# 留空时按 provider 自动选择：
#   provider=deepseek -> https://api.deepseek.com/v1
#   provider=openai   -> 不设置 base_url（openai SDK 走官方）
# 本地 LLM（如 vLLM / Ollama OpenAI 兼容接口）：
#   ANALYTICS_LLM_BASE_URL=http://localhost:8000/v1
ANALYTICS_LLM_BASE_URL=
# DeepSeek-V3（默认）；deepseek-reasoner=R1；gpt-4o-mini 等其他 OpenAI 兼容模型也可
ANALYTICS_LLM_MODEL=deepseek-chat
ANALYTICS_LLM_TIMEOUT=30
ANALYTICS_LLM_TEMPERATURE=0.2
ANALYTICS_LLM_MAX_TOKENS=800
ANALYTICS_INTENT_MIN_CONFIDENCE=0.45
ANALYTICS_HALLUCINATION_TOLERANCE=0.02

# ---- AI 应用编排（人员1）----
# 单体部署用 local；人员3分析服务拆分后改为 http 并配置 BASE_URL。
ANALYTICS_ANALYSIS_API_MODE=local
# ANALYTICS_ANALYSIS_API_BASE_URL=http://analytics-service:5000
# ANALYTICS_ANALYSIS_API_KEY=
ANALYTICS_ANALYSIS_API_TIMEOUT=30
# 面向前端的 assistant API 凭证；production 必填。
# 请求使用 Authorization: Bearer <key> 或 X-Assistant-API-Key: <key>
ANALYTICS_ASSISTANT_API_KEY=

# 仅重试超时、限流和依赖不可用等瞬态失败。
ANALYTICS_TOOL_MAX_ATTEMPTS=3
ANALYTICS_TOOL_RETRY_BASE_SECONDS=0.1
ANALYTICS_TOOL_RETRY_MAX_SECONDS=1.0

# development/testing 可 auto（无 URL 时使用有界内存）；production 必须配置 Redis。
ANALYTICS_CONVERSATION_BACKEND=auto
# ANALYTICS_REDIS_URL=redis://localhost:6379/0
ANALYTICS_REDIS_KEY_PREFIX=medical:conversation:
ANALYTICS_REDIS_SOCKET_TIMEOUT=1.0
ANALYTICS_CONVERSATION_TTL_SECONDS=86400
# 单次分析可能包含 Spark/LLM 长任务；持锁时每 60 秒自动续租。
ANALYTICS_CONVERSATION_LOCK_TIMEOUT_SECONDS=900
ANALYTICS_CONVERSATION_LOCK_BLOCKING_TIMEOUT_SECONDS=30
ANALYTICS_CONVERSATION_LOCK_RENEW_INTERVAL_SECONDS=60
ANALYTICS_CONVERSATION_MAX_SESSIONS=1000
ANALYTICS_CONVERSATION_MAX_MESSAGES=100
ANALYTICS_CONVERSATION_MAX_ANALYSES=20
ANALYTICS_CONVERSATION_MAX_REPORTS=10
ANALYTICS_CONVERSATION_MAX_RESULT_ROWS=200
ANALYTICS_REPORT_MAX_ANALYSES=10
