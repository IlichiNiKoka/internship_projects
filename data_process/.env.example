# =============================================================
# 大数据分析服务模块 环境变量示例
# 复制本文件为 .env 后按需修改（.env 不会提交到版本库）
# 环境变量名以 ANALYTICS_ 为前缀，优先级高于代码内默认值
# =============================================================

# ---- 运行环境 ----
ANALYTICS_ENV=development
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=5000
ANALYTICS_DEBUG=false

# ---- 数据源（清洗后 CSV 路径，默认自动推导到 ./processed/）----
# ANALYTICS_DATA_CSV_PATH=/data/clean.csv

# ---- Spark ----
# 本地开发用 local[*]；生产环境可改为 spark://master:7077 或 yarn
ANALYTICS_SPARK_MASTER=local[*]
ANALYTICS_SPARK_LOG_LEVEL=WARN
# 指定 JAVA_HOME（留空则自动探测：环境变量 -> 候选路径 -> 报错提示）
# Linux 示例：ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# ANALYTICS_SPARK_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# ---- 结果缓存（一期为进程内 TTL 缓存，二期切换 Redis）----
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL_SECONDS=300
ANALYTICS_CACHE_MAX_ENTRIES=256

# ---- 聚合接口限制 ----
ANALYTICS_AGG_MAX_LIMIT=1000

# ---- 机器学习 ----
ANALYTICS_ML_SAMPLE_SIZE=100000
ANALYTICS_ML_TRAIN_RATIO=0.8
