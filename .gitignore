# ============================================================
# 智慧医疗大数据与 AI 大模型分析平台 —— Git 忽略规则
# ============================================================

# ------------------------------
# 1. 数据文件（大体积医疗 CSV / 中间产物）
# ------------------------------
# 原始解压数据（~794 MB，210 万行）
data_process/raw/*.csv
data_process/raw/*.tsv
data_process/raw/*.rar
data_process/raw/*.zip
data_process/raw/*.7z

# 清洗后输出数据（~817 MB）与处理报告（脚本自动生成）
data_process/processed/*_clean.csv
data_process/processed/processing_report.json
# MySQL -> Parquet 列式快照（Spark 直读加速，由后端首次加载自动生成）
data_process/processed/sparcs_snapshot.parquet/

# 数据库备份文件（人员2 · UC6，mysqldump 生成的大体积 .sql）
data_process/backups/

# Docker 基础设施数据文件（不入库，由 deploy-infra.bat 本地导入）
/sparcs_discharge_2021.ibd
deploy/mysql-init/*.gz
deploy/mysql-init/*.sql
deploy/mysql-init/*.zip

# ------------------------------
# 2. Python 编译产物与字节码
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------
# 3. 虚拟环境
# ------------------------------
.venv/
venv/
env/
ENV/
.venv*/
venv*/
env*/

