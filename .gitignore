*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~
.vim/
.lvimrc

# Sublime Text
*.sublime-workspace
*.sublime-project

# Emacs
*~\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

